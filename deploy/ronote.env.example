# A deployment's settings (docs/adr/0014-production-topology.md), other than
# its secrets: copy to ~ronote/.config/ronote/ronote.env and set the two
# domains and the GitHub OAuth app's client ID. The units read it; secrets
# are podman secrets that deploy/install.sh creates, never in this file.
# `podman run --env-file ... ronote-api check-config` checks it, with the
# secrets, without starting anything; it also checks the blob store's bucket
# takes writes, unless --offline. The values are docs/adr/0015-operations.md's:
# the app on a .me domain, the runner on Cloudflare Pages, the blobs in
# Oracle's Object Storage, chat on with its daily cap.
RONOTE_ENV=prod
RONOTE_PUBLIC_URL=https://ronote.example.me
RONOTE_RUNNER_URL=https://ronote-runner.pages.dev
RONOTE_GITHUB_CLIENT_ID=example-client-id
# Caddy's network, ronote-edge (deploy/quadlet/ronote-edge.network).
RONOTE_TRUSTED_PROXIES=10.89.10.0/24
RONOTE_CHAT_ENABLED=true
RONOTE_CHAT_DAILY_USD=0.20
RONOTE_HTTP_ADDR=0.0.0.0:8080
RONOTE_EMBED_URL=http://ronote-ollama:11434
# Searches' queries, on an Ollama of their own (ronote-ollama-query), so a
# query never waits behind a document's indexing (docs/adr/0011-retrieval.md).
RONOTE_EMBED_QUERY_URL=http://ronote-ollama-query:11434
# Each Ollama's CPU threads, sent with every request: the host's 2 cores are
# shared, so indexing takes 1 and a query 2 (docs/adr/0014-production-topology.md).
RONOTE_EMBED_THREADS=1
RONOTE_EMBED_QUERY_THREADS=2
# Object Storage's S3-compatible API, at the tenancy's namespace and region
# (docs/runbook.md); the keys are a Customer Secret Key, as podman secrets.
RONOTE_BLOB_ENDPOINT=https://examplenamespace.compat.objectstorage.eu-frankfurt-1.oraclecloud.com
RONOTE_BLOB_REGION=eu-frankfurt-1
RONOTE_BLOB_BUCKET=ronote-pdfs
# Where alerts go (deploy/alerts): ntfy.sh, to the topic the podman secret
# ronote-ntfy-topic names.
RONOTE_NTFY_URL=https://ntfy.sh
RONOTE_DOCLING_URL=http://ronote-docling:5001
RONOTE_PDFTEXT_URL=http://ronote-pdftext:5002
