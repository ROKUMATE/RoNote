# The smoke suite's deployment: deploy/ronote.env.example's settings, with
# the fakes and the .test domains (deploy/quadlet/ci/README.md).
RONOTE_ENV=test
RONOTE_PUBLIC_URL=https://ronote.test
RONOTE_RUNNER_URL=https://ronote-run.test
RONOTE_GITHUB_CLIENT_ID=ronote-e2e
RONOTE_GITHUB_AUTHORIZE_URL=https://idp.ronote.test/login/oauth/authorize
RONOTE_GITHUB_TOKEN_URL=http://ronote-fakeidp:8090/login/oauth/access_token
RONOTE_GITHUB_API_URL=http://ronote-fakeidp:8090/
RONOTE_TRUSTED_PROXIES=10.89.10.0/24
RONOTE_FETCH_ALLOW_PRIVATE=true
RONOTE_CHAT_ENABLED=true
RONOTE_CHAT_URL=http://ronote-fakellm:8094
RONOTE_HTTP_ADDR=0.0.0.0:8080
RONOTE_EMBED_URL=http://ronote-ollama:11434
RONOTE_EMBED_QUERY_URL=http://ronote-ollama-query:11434
RONOTE_EMBED_THREADS=1
RONOTE_EMBED_QUERY_THREADS=2
RONOTE_EMBED_MODEL=fake-words
RONOTE_BLOB_ENDPOINT=http://ronote-seaweedfs:8333
RONOTE_BLOB_REGION=us-east-1
RONOTE_BLOB_BUCKET=ronote
RONOTE_DOCLING_URL=http://ronote-docling:5001
RONOTE_PDFTEXT_URL=http://ronote-pdftext:5002
