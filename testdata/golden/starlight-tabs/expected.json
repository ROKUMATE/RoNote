        {
          "text": "Import"
        }
      ]
    },
    {
      "id": "0adffd94d101",
      "kind": "code",
      "lang": "tsx",
      "text": "import { Tabs, TabItem } from '@astrojs/starlight/components';"
    },
    {
      "id": "7d18452dd063",
      "kind": "heading",
      "level": 2,
      "anchor": "usage",
      "content": [
        {
          "text": "Usage"
        }
      ]
    },
    {
      "id": "88001f4e6c5f",
      "kind": "paragraph",
      "content": [
        {
          "text": "Display a tabbed interface using the "
        },
        {
          "text": "<Tabs>",
          "marks": [
            "code"
          ]
        },
        {
          "text": " and "
        },
        {
          "text": "<TabItem>",
          "marks": [
            "code"
          ]
        },
        {
          "text": " components. Each "
        },
        {
          "text": "<TabItem>",
          "marks": [
            "code"
          ]
        },
        {
          "text": " must have a "
        },
        {
          "text": "label",
          "marks": [
            "code"
          ],
          "link": {
            "href": "#label",
            "kind": "anchor"
          }
        },
        {
          "text": " to display to users."
        }
      ]
    },
    {
      "id": "16ed7743397c",
      "kind": "tabs",
      "items": [
        {
          "label": "MDX",
          "children": [
            {
              "id": "979e0f711328",
              "kind": "code",
              "lang": "mdx",
              "text": "import { Tabs, TabItem } from '@astrojs/starlight/components';\n\n<Tabs>\n  <TabItem label=\"Stars\">Sirius, Vega, Betelgeuse</TabItem>\n  <TabItem label=\"Moons\">Io, Europa, Ganymede</TabItem>\n</Tabs>"
            }
          ]
        },
        {
          "label": "Markdoc",
          "children": [
            {
              "id": "e598893e0630",
              "kind": "code",
              "lang": "markdoc",
              "text": "{% tabs %}\n{% tabitem label=\"Stars\" %}\nSirius, Vega, Betelgeuse\n{% /tabitem %}\n\n{% tabitem label=\"Moons\" %}\nIo, Europa, Ganymede\n{% /tabitem %}\n{% /tabs %}"
            }
          ]
        }
      ]
    },
