        {
          "id": "87a2e0b9d590",
          "kind": "paragraph",
          "content": [
            {
              "text": "You can use "
            },
            {
              "text": ".",
              "marks": [
                "code"
              ]
            },
            {
              "text": " for the project name to scaffold in the current directory."
            }
          ]
        },
        {
          "id": "9a0102244d76",
          "kind": "paragraph",
          "content": [
            {
              "text": "To create a project without interactive prompts, you can use the "
            },
            {
              "text": "--no-interactive",
              "marks": [
