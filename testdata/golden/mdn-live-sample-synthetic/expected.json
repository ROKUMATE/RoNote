    {
      "id": "d63323e56ed3",
      "kind": "paragraph",
      "content": [
        {
          "text": "The page has one button and one output line:"
        }
      ]
    },
    {
      "id": "9fc6c95c865f",
      "kind": "code",
      "lang": "html",
      "text": "<button id=\"greet\">Greet</button>\n<p id=\"out\"></p>\n"
