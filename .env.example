# Deployment environment: dev, test, staging or prod. Required.
RONOTE_ENV=dev
# Address the API listens on. Defaults to 127.0.0.1:8080.
RONOTE_HTTP_ADDR=127.0.0.1:8080
# Log level: debug, info, warn or error. Defaults to info.
RONOTE_LOG_LEVEL=info
# Postgres URL (postgres:// form). Required. This one matches deploy/compose.dev.yml.
RONOTE_DATABASE_URL=postgres://ronote:ronote@127.0.0.1:5432/ronote?sslmode=disable
# Let the page fetcher reach loopback and private networks on any port. Only allowed when RONOTE_ENV is dev or test. Defaults to false.
RONOTE_FETCH_ALLOW_PRIVATE=false
# How long a fetched page stays fresh: imports within it reuse the stored copy without asking the site. A Go duration; 0s always revalidates. Defaults to 24h.
RONOTE_SOURCE_TTL=24h
# Where the Vite dev server (make web-dev) sends /api. Defaults to http://127.0.0.1:8080, the API's default address.
RONOTE_API_ORIGIN=http://127.0.0.1:8080
# Where the runner page, which runs code from documents, is served (make web-dev starts it). Defaults to http://localhost:5174 in dev and test: not 127.0.0.1, whose cookies the app's origin would share. Read when the page is served, not built. Required in staging and prod, https, on a registrable domain other than RONOTE_PUBLIC_URL's (docs/adr/0014-production-topology.md).
RONOTE_RUNNER_URL=http://localhost:5174
# The networks of the proxies in front of the API (CIDRs or IPs, comma- or space-separated), whose X-Forwarded-For then says which client a request is from. Anyone else's header is ignored. Defaults to none: the connection's address is the client's. Production sets Caddy's network (docs/adr/0014-production-topology.md).
RONOTE_TRUSTED_PROXIES=
# The OAuth app the API signs in with (docs/adr/0010-sign-in-and-sessions.md). In dev and test the fake provider (make run-idp) accepts these same values.
RONOTE_GITHUB_CLIENT_ID=ronote-dev
RONOTE_GITHUB_CLIENT_SECRET=ronote-dev-secret
# The origin people reach RoNote at: sign-in's callback is under it, it is the only origin trusted to send the API cross-origin requests, and the only one the runner lets frame it. Required; https in staging and prod. In dev, the Vite server's.
RONOTE_PUBLIC_URL=http://127.0.0.1:5173
# Where sign-in goes: GitHub by default, and only GitHub in staging and prod. Dev and test point them at the fake provider.
RONOTE_GITHUB_AUTHORIZE_URL=http://127.0.0.1:8090/login/oauth/authorize
RONOTE_GITHUB_TOKEN_URL=http://127.0.0.1:8090/login/oauth/access_token
RONOTE_GITHUB_API_URL=http://127.0.0.1:8090
# The fake provider's address and its users (make run-idp, make web-dev). Default to these.
RONOTE_FAKEIDP_ADDR=127.0.0.1:8090
RONOTE_FAKEIDP_USERS=deploy/fakeidp/dev-users.json
# Quotas and rate limits (docs/adr/0010-sign-in-and-sessions.md). Imports per user in any 24 hours; documents per user, counting imports under way; API requests per user per minute, the import event stream excepted; sign-in requests per IP per minute. Default to these.
RONOTE_LIMIT_IMPORTS_PER_DAY=60
RONOTE_LIMIT_DOCUMENTS=500
RONOTE_LIMIT_API_PER_MINUTE=120
RONOTE_LIMIT_AUTH_PER_MINUTE=20
# The embedder search uses (docs/adr/0011-retrieval.md): Ollama's address (its native /api/embed, which refuses an input over the model's context; not /v1), and its model. Default to Ollama's, with the pinned Qwen3 model (ollama pull qwen3-embedding:0.6b; make doctor checks). Changing the model reindexes every document.
RONOTE_EMBED_URL=http://127.0.0.1:11434
RONOTE_EMBED_MODEL=qwen3-embedding:0.6b
# Chat (docs/adr/0012-chat.md): the kill switch, the Messages API, and the model. The URL defaults to Anthropic's API, which needs RONOTE_ANTHROPIC_API_KEY and costs money; dev talks to the fake model (cmd/fakellm), which make web-dev starts. For the real model, set RONOTE_CHAT_URL=https://api.anthropic.com and the key. The model defaults to this. Enabled defaults to true in dev and test and to false in staging and prod, where only RONOTE_CHAT_ENABLED=true turns chat on.
RONOTE_CHAT_ENABLED=true
RONOTE_CHAT_URL=http://127.0.0.1:8094
RONOTE_CHAT_MODEL=claude-haiku-5-5
# Anthropic's API key, for the real model only. Left unset here: a value in this file overrides the shell's.
# RONOTE_ANTHROPIC_API_KEY=
# The fake model's address (make web-dev, make run-llm). Defaults to this.
RONOTE_FAKELLM_ADDR=127.0.0.1:8094
# Chat quotas per user in any 24 hours: questions, and the input tokens their answers read. Default to these.
RONOTE_LIMIT_CHAT_MESSAGES_PER_DAY=50
RONOTE_LIMIT_CHAT_TOKENS_PER_DAY=400000
# What every user's chat answers may cost together in a UTC day, in dollars; past it chat answers chat_spend_cap_reached until midnight UTC (docs/adr/0014-production-topology.md). Defaults to 0.50.
RONOTE_CHAT_DAILY_USD=0.50
# Where uploaded PDFs are kept (docs/adr/0013-pdf-import.md): any S3-compatible store. Dev and test default to the dev stack's SeaweedFS (make dev-up), these values; staging and prod must set every one.
RONOTE_BLOB_ENDPOINT=http://127.0.0.1:8333
RONOTE_BLOB_REGION=us-east-1
RONOTE_BLOB_BUCKET=ronote
RONOTE_BLOB_ACCESS_KEY=ronote
RONOTE_BLOB_SECRET_KEY=ronote-dev-secret
# What converts PDFs: docling-serve, and pdftext, which reads the text layer. Dev and test default to these, where make dev-up-docling runs the real ones and make run-docling (make web-dev starts it) the fake that replays recordings; staging and prod must set every one.
RONOTE_DOCLING_URL=http://127.0.0.1:5001
RONOTE_DOCLING_API_KEY=ronote-dev-docling
RONOTE_PDFTEXT_URL=http://127.0.0.1:5002
RONOTE_PDFTEXT_API_KEY=ronote-dev-pdftext
# The fake docling and pdftext's addresses and recordings (make run-docling, make web-dev). Default to these.
RONOTE_FAKEDOCLING_ADDR=127.0.0.1:5001
RONOTE_FAKEPDFTEXT_ADDR=127.0.0.1:5002
RONOTE_FAKEDOCLING_RECORDINGS=testdata/pdf
