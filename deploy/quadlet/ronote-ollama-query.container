# The query embedder: a second Ollama, the same image and the same model, for
# searches' queries alone, so a query never waits behind a document's
# indexing, which holds the other one a chunk at a time, about 1.9 s each on
# CI's arm64 runner (docs/adr/0011-retrieval.md). It reads ronote-ollama's
# volume read-only, with no pull and no pruning: the model ronote-ollama
# pulled and laid out, which is why it starts after it. A context of 2048
# (search.QueryContext), which the longest query, 500 characters, fits with
# its prefix in any script; one model, one request at a time, kept loaded.
# Its limit is provisional until the ARM job measures it (ADR 0014). The api
# checks on its first answer that both serve the model with one digest, and
# searches by words alone if they don't (deploy/units_test.go).

[Unit]
Description=RoNote query embedder
Wants=ronote-ollama.service
After=ronote-ollama.service

[Container]
ContainerName=ronote-ollama-query
Image=docker.io/ollama/ollama:0.40.16@sha256:910d0d8107b538fb0894e63163eb195de0cc7aefcbc666dc62d3b18f71124592
Network=ronote-data.network
Volume=ronote-ollama.volume:/root/.ollama:ro
Environment=OLLAMA_HOST=0.0.0.0:11434
Environment=OLLAMA_CONTEXT_LENGTH=2048 OLLAMA_NUM_PARALLEL=1 OLLAMA_MAX_LOADED_MODELS=1 OLLAMA_KEEP_ALIVE=-1 OLLAMA_NOPRUNE=1
ReadOnly=true
ReadOnlyTmpfs=true
NoNewPrivileges=true
DropCapability=ALL
PodmanArgs=--memory=1536m --cpus=2
HealthCmd=ollama list
HealthInterval=15s
HealthStartPeriod=60s
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
