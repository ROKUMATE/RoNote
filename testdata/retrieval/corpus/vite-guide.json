              ]
            },
            {
              "text": " flag."
            }
          ]
        }
      ]
    },
    {
      "id": "6b2d3d868f39",
      "kind": "heading",
      "level": 2,
      "anchor": "community-templates",
      "content": [
        {
          "text": "Community Templates"
        }
      ]
    },
    {
      "id": "40319bef20c3",
      "kind": "paragraph",
      "content": [
        {
          "text": "create-vite is a tool to quickly start a project from a basic template for popular frameworks. Check out Awesome Vite for "
        },
        {
          "text": "community maintained templates",
          "link": {
            "href": "https://github.com/vitejs/awesome-vite#templates",
            "kind": "external"
          }
        },
        {
          "text": " that include other tools or target different frameworks."
        }
      ]
    },
    {
      "id": "f0f55820a830",
      "kind": "paragraph",
      "content": [
        {
          "text": "For a template at "
        },
        {
          "text": "https://github.com/user/project",
          "marks": [
            "code"
          ]
        },
        {
          "text": ", you can try it out online using "
        },
        {
          "text": "https://github.stackblitz.com/user/project",
          "marks": [
            "code"
          ]
        },
        {
          "text": " (adding "
        },
        {
          "text": ".stackblitz",
          "marks": [
            "code"
          ]
        },
        {
          "text": " after "
        },
        {
          "text": "github",
          "marks": [
            "code"
          ]
        },
        {
          "text": " to the URL of the project)."
        }
      ]
    },
    {
      "id": "af62ba4318ee",
      "kind": "paragraph",
      "content": [
        {
          "text": "You can also use a tool like "
        },
        {
          "text": "tiged",
          "link": {
            "href": "https://github.com/tiged/tiged",
            "kind": "external"
          }
        },
        {
          "text": " to scaffold your project with one of the templates. Assuming the project is on GitHub and uses "
        },
        {
          "text": "main",
          "marks": [
            "code"
          ]
        },
        {
          "text": " as the default branch, you can create a local copy using:"
        }
      ]
    },
    {
      "id": "dcfbc22c33b3",
      "kind": "code",
      "lang": "bash",
      "text": "npx tiged user/project my-project\ncd my-project\n\nnpm install\nnpm run dev"
    },
    {
      "id": "ad61e47641be",
      "kind": "heading",
      "level": 2,
      "anchor": "manual-installation",
      "content": [
        {
          "text": "Manual Installation"
        }
      ]
    },
    {
      "id": "5c46f5c7ebe2",
      "kind": "paragraph",
      "content": [
        {
          "text": "In your project, you can install the "
        },
        {
          "text": "vite",
          "marks": [
            "code"
          ]
        },
        {
          "text": " CLI using:"
        }
      ]
    },
    {
      "id": "3091cf0a3971",
      "kind": "tabs",
      "items": [
        {
          "label": "npm",
          "children": [
            {
              "id": "2fa721e63f55",
              "kind": "code",
              "lang": "bash",
              "text": "npm install -D vite"
            }
          ]
        },
        {
          "label": "Yarn",
          "children": [
            {
              "id": "3a6b7cc02b0d",
              "kind": "code",
              "lang": "bash",
              "text": "yarn add -D vite"
            }
          ]
        },
        {
          "label": "pnpm",
          "children": [
            {
              "id": "230266132634",
              "kind": "code",
              "lang": "bash",
              "text": "pnpm add -D vite"
            }
          ]
        },
        {
          "label": "Bun",
          "children": [
            {
              "id": "2370d41d1a1e",
              "kind": "code",
              "lang": "bash",
              "text": "bun add -D vite"
            }
          ]
        },
        {
          "label": "Deno",
          "children": [
            {
              "id": "b9d14c50f69f",
              "kind": "code",
              "lang": "bash",
              "text": "deno add -D npm:vite"
            }
          ]
        }
      ]
    },
    {
      "id": "a5ed709a378e",
      "kind": "paragraph",
      "content": [
        {
          "text": "And create an "
        },
        {
          "text": "index.html",
          "marks": [
            "code"
          ]
        },
        {
          "text": " file like this:"
        }
      ]
    },
    {
      "id": "50ac6f2730fe",
      "kind": "code",
      "lang": "html",
      "text": "<p>Hello Vite!</p>"
    },
    {
      "id": "44bfa3efdb9b",
      "kind": "paragraph",
      "content": [
        {
          "text": "Then run the appropriate CLI command in your terminal:"
        }
      ]
    },
    {
      "id": "d3e171e6d272",
      "kind": "tabs",
      "items": [
        {
          "label": "npm",
          "children": [
            {
              "id": "3b3a7f7a05bf",
              "kind": "code",
              "lang": "bash",
              "text": "npx vite"
            }
          ]
        },
        {
          "label": "Yarn",
          "children": [
            {
              "id": "79c5e6fc27bf",
              "kind": "code",
              "lang": "bash",
              "text": "yarn vite"
            }
          ]
        },
        {
          "label": "pnpm",
          "children": [
            {
              "id": "5e5b87e2e43c",
              "kind": "code",
              "lang": "bash",
              "text": "pnpm vite"
            }
          ]
        },
        {
          "label": "Bun",
          "children": [
            {
              "id": "2e4d7f94a80b",
              "kind": "code",
              "lang": "bash",
              "text": "bunx vite"
            }
          ]
        },
        {
          "label": "Deno",
          "children": [
            {
              "id": "016eea03f1fd",
              "kind": "code",
              "lang": "bash",
              "text": "deno run -A npm:vite"
            }
          ]
        }
      ]
    },
    {
      "id": "eb3861e38518",
      "kind": "paragraph",
      "content": [
        {
          "text": "The "
        },
        {
          "text": "index.html",
          "marks": [
            "code"
          ]
        },
        {
          "text": " will be served on "
        },
        {
          "text": "http://localhost:5173",
          "marks": [
            "code"
          ]
        },
        {
          "text": "."
        }
      ]
    },
    {
      "id": "5a3b9458427d",
      "kind": "heading",
      "level": 2,
      "anchor": "index-html-and-project-root",
      "content": [
        {
          "text": "index.html",
          "marks": [
            "code"
          ]
        },
        {
          "text": " and Project Root"
        }
      ]
    },
    {
      "id": "25cdb4e441aa",
      "kind": "paragraph",
      "content": [
        {
          "text": "One thing you may have noticed is that in a Vite project, "
        },
        {
          "text": "index.html",
          "marks": [
            "code"
          ]
        },
        {
          "text": " is front-and-central instead of being tucked away inside "
        },
        {
          "text": "public",
          "marks": [
            "code"
          ]
        },
        {
          "text": ". This is intentional: during development Vite is a server, and "
        },
        {
          "text": "index.html",
          "marks": [
            "code"
          ]
        },
        {
          "text": " is the entry point to your application."
        }
      ]
    },
    {
      "id": "250edfaa86ff",
      "kind": "paragraph",
      "content": [
        {
          "text": "Vite treats "
        },
        {
          "text": "index.html",
          "marks": [
            "code"
          ]
        },
        {
          "text": " as source code and part of the module graph. It resolves "
        },
        {
          "text": "<script type=\"module\" src=\"...\">",
          "marks": [
            "code"
          ]
        },
        {
          "text": " that references your JavaScript source code. Even inline "
        },
        {
          "text": "<script type=\"module\">",
          "marks": [
            "code"
          ]
        },
        {
          "text": " and CSS referenced via "
        },
        {
          "text": "<link href>",
          "marks": [
            "code"
          ]
        },
        {
          "text": " also enjoy Vite-specific features. In addition, URLs inside "
        },
        {
          "text": "index.html",
          "marks": [
            "code"
          ]
        },
        {
          "text": " are automatically rebased so there's no need for special "
        },
        {
          "text": "%PUBLIC_URL%",
          "marks": [
            "code"
          ]
        },
        {
          "text": " placeholders."
        }
      ]
    },
    {
      "id": "834a60d813e0",
      "kind": "paragraph",
      "content": [
        {
          "text": "Similar to static http servers, Vite has the concept of a \"root directory\" which your files are served from. You will see it referenced as "
        },
        {
          "text": "<root>",
          "marks": [
            "code"
          ]
        },
        {
          "text": " throughout the rest of the docs. Absolute URLs in your source code will be resolved using the project root as base, so you can write code as if you are working with a normal static file server (except way more powerful!). Vite is also capable of handling dependencies that resolve to out-of-root file system locations, which makes it usable even in a monorepo-based setup."
        }
      ]
    },
    {
      "id": "55842fc5c141",
      "kind": "paragraph",
      "content": [
        {
          "text": "Vite also supports "
        },
        {
          "text": "multi-page apps",
          "link": {
            "href": "https://vite.dev/guide/build#multi-page-app",
            "kind": "same_domain"
          }
        },
        {
          "text": " with multiple "
        },
        {
          "text": ".html",
          "marks": [
            "code"
          ]
        },
        {
          "text": " entry points."
        }
      ]
    },
    {
      "id": "4404da458ab5",
      "kind": "heading",
      "level": 4,
      "anchor": "specifying-alternative-root",
      "content": [
        {
          "text": "Specifying Alternative Root"
        }
      ]
    },
    {
      "id": "a0c1e9a263d8",
      "kind": "paragraph",
      "content": [
        {
          "text": "Running "
        },
        {
          "text": "vite",
          "marks": [
            "code"
          ]
        },
        {
          "text": " starts the dev server using the current working directory as root. You can specify an alternative root with "
        },
        {
          "text": "vite serve some/sub/dir",
          "marks": [
            "code"
          ]
        },
        {
          "text": ". Note that Vite will also resolve "
        },
        {
          "text": "its config file (i.e. ",
          "link": {
            "href": "https://vite.dev/config/#configuring-vite",
            "kind": "same_domain"
          }
        },
        {
          "text": "vite.config.js",
          "marks": [
            "code"
          ],
          "link": {
            "href": "https://vite.dev/config/#configuring-vite",
            "kind": "same_domain"
          }
        },
        {
          "text": ")",
          "link": {
            "href": "https://vite.dev/config/#configuring-vite",
            "kind": "same_domain"
          }
        },
        {
          "text": " inside the project root, so you'll need to move it if the root is changed."
        }
      ]
    },
    {
      "id": "46d6169feaa2",
      "kind": "heading",
      "level": 2,
      "anchor": "command-line-interface",
      "content": [
        {
          "text": "Command Line Interface"
        }
      ]
    },
    {
      "id": "87fa5327242c",
      "kind": "paragraph",
      "content": [
        {
          "text": "In a project where Vite is installed, you can use the "
        },
        {
          "text": "vite",
          "marks": [
            "code"
          ]
        },
        {
          "text": " binary in your npm scripts, or run it directly with "
        },
        {
          "text": "npx vite",
          "marks": [
            "code"
          ]
        },
        {
          "text": ". Here are the default npm scripts in a scaffolded Vite project:"
        }
      ]
    },
    {
      "id": "e37d1c276174",
      "kind": "paragraph",
      "content": [
        {
          "text": "package.json"
        }
      ]
    },
    {
      "id": "07cf49124794",
      "kind": "code",
      "lang": "json",
      "text": "{\n  \"scripts\": {\n    \"dev\": \"vite\", // start dev server, aliases: `vite dev`, `vite serve`\n    \"build\": \"vite build\", // build for production\n    \"preview\": \"vite preview\" // locally preview production build\n  }\n}"
    },
    {
      "id": "6ea23d8d4641",
      "kind": "paragraph",
      "content": [
        {
          "text": "You can specify additional CLI options like "
        },
        {
          "text": "--port",
          "marks": [
            "code"
          ]
        },
        {
          "text": " or "
        },
        {
          "text": "--open",
          "marks": [
            "code"
          ]
        },
        {
          "text": ". For a full list of CLI options, run "
        },
        {
          "text": "npx vite --help",
          "marks": [
            "code"
          ]
        },
        {
          "text": " in your project."
        }
      ]
    },
    {
      "id": "c701e58e87ce",
      "kind": "paragraph",
      "content": [
        {
          "text": "Learn more about the "
        },
        {
          "text": "Command Line Interface",
          "link": {
            "href": "https://vite.dev/guide/cli",
            "kind": "same_domain"
          }
        },
        {
          "text": "."
        }
      ]
    },
    {
      "id": "5667e3f0216e",
      "kind": "heading",
      "level": 2,
      "anchor": "using-unreleased-commits",
      "content": [
        {
          "text": "Using Unreleased Commits"
        }
      ]
    },
    {
      "id": "b3b4a48c6459",
      "kind": "paragraph",
      "content": [
        {
          "text": "If you can't wait for a new release to test the latest features, you can install a specific commit of Vite with "
        },
        {
          "text": "https://pkg.pr.new",
          "link": {
            "href": "https://pkg.pr.new",
            "kind": "external"
          }
        },
        {
          "text": ":"
        }
      ]
    },
    {
      "id": "e7f8ad9746ca",
      "kind": "tabs",
      "items": [
        {
          "label": "npm",
          "children": [
            {
              "id": "3a8610bf064c",
              "kind": "code",
              "lang": "bash",
              "text": "npm install -D https://pkg.pr.new/vite@SHA"
            }
          ]
        },
        {
          "label": "Yarn",
          "children": [
            {
              "id": "ea7051e06e30",
              "kind": "code",
              "lang": "bash",
              "text": "yarn add -D https://pkg.pr.new/vite@SHA"
            }
          ]
        },
        {
          "label": "pnpm",
          "children": [
            {
              "id": "d37f996f9e9c",
              "kind": "code",
              "lang": "bash",
              "text": "pnpm add -D https://pkg.pr.new/vite@SHA"
            }
          ]
        },
        {
          "label": "Bun",
          "children": [
            {
              "id": "4ca4b18afc6a",
              "kind": "code",
              "lang": "bash",
              "text": "bun add -D https://pkg.pr.new/vite@SHA"
            }
          ]
        }
      ]
    },
    {
      "id": "3256d4637c64",
      "kind": "paragraph",
      "content": [
        {
          "text": "Replace "
        },
        {
          "text": "SHA",
          "marks": [
            "code"
          ]
        },
        {
          "text": " with any of "
        },
        {
          "text": "Vite's commit SHAs",
          "link": {
            "href": "https://github.com/vitejs/vite/commits/main/",
            "kind": "external"
          }
        },
        {
          "text": ". Note that only commits within the last month will work, as older commit releases are purged."
        }
      ]
    },
    {
      "id": "f0294353a684",
      "kind": "paragraph",
      "content": [
        {
          "text": "Alternatively, you can also clone the "
        },
        {
          "text": "vite repo",
          "link": {
            "href": "https://github.com/vitejs/vite",
            "kind": "external"
          }
        },
        {
          "text": " to your local machine and then build and link it yourself ("
        },
        {
          "text": "pnpm",
          "link": {
            "href": "https://pnpm.io/",
            "kind": "external"
          }
        },
        {
          "text": " is required):"
        }
      ]
    },
    {
      "id": "01572bd2ca8a",
      "kind": "code",
      "lang": "bash",
      "text": "git clone https://github.com/vitejs/vite.git\ncd vite\npnpm install\ncd packages/vite\npnpm run build\npnpm link # use your preferred package manager for this step"
    },
    {
      "id": "f407f8befe23",
      "kind": "paragraph",
      "content": [
        {
          "text": "Then go to your Vite based project and run "
        },
        {
          "text": "pnpm link vite",
          "marks": [
            "code"
          ]
        },
        {
          "text": " (or the package manager that you used to link "
        },
        {
          "text": "vite",
          "marks": [
            "code"
          ]
        },
        {
          "text": " globally). Now restart the development server to ride on the bleeding edge!"
        }
      ]
    },
    {
      "id": "4fddb438c42f",
      "kind": "paragraph",
      "content": [
        {
          "text": "To learn more about how and when Vite does releases, check out the "
        },
        {
          "text": "Releases",
          "link": {
            "href": "https://vite.dev/releases",
            "kind": "same_domain"
          }
        },
        {
          "text": " documentation."
        }
      ]
    },
    {
      "id": "90ea004ba202",
      "kind": "callout",
      "variant": "tip",
      "title": "Dependencies using Vite",
      "children": [
        {
          "id": "3ae9def39386",
          "kind": "paragraph",
          "content": [
            {
              "text": "To replace the Vite version used by dependencies transitively, you should use "
            },
            {
              "text": "npm overrides",
              "link": {
                "href": "https://docs.npmjs.com/cli/v11/configuring-npm/package-json#overrides",
                "kind": "external"
              }
            },
            {
              "text": " or "
            },
            {
              "text": "pnpm overrides",
              "link": {
                "href": "https://pnpm.io/settings#overrides",
                "kind": "external"
              }
            },
            {
              "text": "."
            }
          ]
        }
      ]
    },
    {
      "id": "706551fe99ce",
      "kind": "heading",
      "level": 2,
      "anchor": "community",
      "content": [
        {
          "text": "Community"
        }
      ]
    },
    {
      "id": "604354b27bd7",
      "kind": "paragraph",
      "content": [
        {
          "text": "If you have questions or need help, reach out to the community at "
        },
        {
          "text": "Discord",
          "link": {
            "href": "https://chat.vite.dev",
            "kind": "external"
          }
        },
        {
          "text": " and "
        },
        {
          "text": "GitHub Discussions",
          "link": {
            "href": "https://github.com/vitejs/vite/discussions",
            "kind": "external"
          }
        },
        {
          "text": "."
        }
      ]
    }
  ]
}
