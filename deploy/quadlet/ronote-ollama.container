# The embedder: Ollama with the pinned model, which deploy/install.sh pulls
# into its volume and checks against the pin. It then has no way out. One
# model, one request at a time, kept loaded (its memory is in the budget,
# and a cold load would hold up the first search after an idle spell); a
# context of 4096, the largest embedding input and the query prefix rounded
# up to a power of two, whose KV cache is 448 MiB (deploy/units_test.go).

[Unit]
Description=RoNote embedder

[Container]
ContainerName=ronote-ollama
Image=docker.io/ollama/ollama:0.40.16@sha256:910d0d8107b538fb0894e63163eb195de0cc7aefcbc666dc62d3b18f71124592
Network=ronote-data.network
Volume=ronote-ollama.volume:/root/.ollama
Environment=OLLAMA_HOST=0.0.0.0:11434
Environment=OLLAMA_CONTEXT_LENGTH=4096 OLLAMA_NUM_PARALLEL=1 OLLAMA_MAX_LOADED_MODELS=1 OLLAMA_KEEP_ALIVE=-1
ReadOnly=true
ReadOnlyTmpfs=true
NoNewPrivileges=true
DropCapability=ALL
PodmanArgs=--memory=2g --cpus=2
HealthCmd=ollama list
HealthInterval=15s
HealthStartPeriod=60s
Notify=healthy

[Service]
# Batch work: under contention it yields to the interactive units (CPU
# weight 50 against their 1000; docs/adr/0014-production-topology.md).
CPUWeight=50
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
