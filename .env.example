# Deployment environment: dev, test, staging or prod. Required.
RONOTE_ENV=dev
# Address the API listens on. Defaults to 127.0.0.1:8080.
RONOTE_HTTP_ADDR=127.0.0.1:8080
# Log level: debug, info, warn or error. Defaults to info.
RONOTE_LOG_LEVEL=info
# Postgres URL (postgres:// form). Required. This one matches deploy/compose.dev.yml.
RONOTE_DATABASE_URL=postgres://ronote:ronote@127.0.0.1:5432/ronote?sslmode=disable
# Let the page fetcher reach loopback and private networks on any port. Only allowed when RONOTE_ENV is dev or test. Defaults to false.
RONOTE_FETCH_ALLOW_PRIVATE=false
# How long a fetched page stays fresh: imports within it reuse the stored copy without asking the site. A Go duration; 0s always revalidates. Defaults to 24h.
RONOTE_SOURCE_TTL=24h
# The user every API request acts as until real sign-in exists. Only allowed when RONOTE_ENV is dev or test; without it the API answers 401.
RONOTE_DEV_USER_EMAIL=dev@ronote.local
# Where the Vite dev server (make web-dev) sends /api. Defaults to http://127.0.0.1:8080, the API's default address.
RONOTE_API_ORIGIN=http://127.0.0.1:8080
# Where the runner page, which runs code from documents, is served (make web-dev starts it). Defaults to http://localhost:5174: not 127.0.0.1, whose cookies the app's origin would share.
RONOTE_RUNNER_ORIGIN=http://localhost:5174
# The app's origins, the only ones that may frame the runner and talk to it. Space- or comma-separated. Defaults to http://127.0.0.1:5173.
RONOTE_APP_ORIGINS=http://127.0.0.1:5173
# The OAuth app the API signs in with (docs/adr/0010-sign-in-and-sessions.md). In dev and test the fake provider (make run-idp) accepts these same values.
RONOTE_GITHUB_CLIENT_ID=ronote-dev
RONOTE_GITHUB_CLIENT_SECRET=ronote-dev-secret
