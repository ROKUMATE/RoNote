          }
        }
      ]
    },
    {
      "id": "55c4ceabd7e6",
      "kind": "paragraph",
      "content": [
        {
          "text": "A program reads a file in one call. The listing hides the lines that only make it compile."
        }
      ]
    },
    {
      "id": "a18b40176671",
      "kind": "code",
      "lang": "rust",
      "text": "let text = fs::read_to_string(\"notes.txt\")?;\nprintln!(\"{} bytes\", text.len());\n",
      "title": "Filename: src/main.rs"
    },
    {
      "id": "2ad88aef0b17",
      "kind": "paragraph",
      "content": [
        {
          "text": "Run it:"
        }
      ]
    },
    {
      "id": "d5b7259cdf58",
      "kind": "code",
      "lang": "console",
      "text": "$ cargo run\n   Compiling notes v0.1.0\n42 bytes\n"
    },
    {
      "id": "bd7b98b7d3cc",
      "kind": "quote",
      "children": [
        {
          "id": "c821f4599a37",
          "kind": "paragraph",
          "content": [
            {
              "text": "Note: the file must be UTF-8."
            }
          ]
        }
      ]
    },
