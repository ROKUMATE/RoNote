        {
          "text": "Install the CLI"
        }
      ]
    },
    {
      "id": "d7d718816350",
      "kind": "paragraph",
      "content": [
        {
          "text": "The CLI installs with any Node package manager."
        }
      ]
    },
    {
      "id": "913d824d8db6",
      "kind": "tabs",
      "items": [
        {
          "label": "npm",
          "children": [
            {
              "id": "92cb1044ca1e",
              "kind": "code",
              "lang": "bash",
              "text": "npm install --global example-kit\n"
            }
          ]
        },
        {
          "label": "Yarn",
          "children": [
            {
              "id": "f3e5b117d685",
              "kind": "code",
              "lang": "bash",
              "text": "yarn global add example-kit\n"
            }
          ]
        }
      ]
    },
    {
      "id": "fa0ec76d22ce",
      "kind": "callout",
      "variant": "danger",
      "title": "Never run it as root",
      "children": [
        {
          "id": "9982f191a1cb",
          "kind": "paragraph",
          "content": [
            {
              "text": "It writes to your home directory only."
            }
          ]
        }
      ]
    },
    {
      "id": "4eb5fa3c4932",
      "kind": "heading",
      "level": 2,
