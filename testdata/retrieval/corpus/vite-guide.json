        {
          "text": "Scaffolding Your First Vite Project"
        }
      ]
    },
    {
      "id": "dfdc53ff5836",
      "kind": "tabs",
      "items": [
        {
          "label": "npm",
          "children": [
            {
              "id": "22198dd7607f",
              "kind": "code",
              "lang": "bash",
              "text": "npm create vite@latest"
            }
          ]
        },
        {
          "label": "Yarn",
          "children": [
            {
              "id": "105259345ecf",
              "kind": "code",
              "lang": "bash",
              "text": "yarn create vite"
            }
          ]
        },
        {
          "label": "pnpm",
          "children": [
            {
              "id": "13a5d9c230ad",
              "kind": "code",
              "lang": "bash",
              "text": "pnpm create vite"
            }
          ]
        },
        {
          "label": "Bun",
          "children": [
            {
              "id": "05d4181e8931",
              "kind": "code",
              "lang": "bash",
              "text": "bun create vite"
            }
          ]
        },
        {
          "label": "Deno",
          "children": [
            {
              "id": "27294eb53499",
